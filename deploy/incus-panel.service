[Unit]
Description=Incus Panel - administração local
After=network-online.target incus.service
Wants=network-online.target
Requires=incus.service

[Service]
Type=simple
User=incus-panel
WorkingDirectory=/opt/incus-panel/current
StateDirectory=incus-panel
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -m incus_panel.server --config /etc/incus-panel/config.local.json --users-file /var/lib/incus-panel/users.json --port 8444
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=100%
MemoryAccounting=true
MemoryHigh=64M
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_MMAP_THRESHOLD_=131072

[Install]
WantedBy=multi-user.target
