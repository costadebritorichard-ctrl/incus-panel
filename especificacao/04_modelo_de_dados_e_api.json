{
  "modelo_de_dados_conceitual": [
    {
      "entidade": "ServidorIncus",
      "id_logico": "server_id",
      "campos": [
        "alias",
        "url_identidade",
        "fingerprint_tls",
        "versao_incus",
        "arquitetura_host",
        "server_clustered",
        "ultima_conexao",
        "estado_conexao"
      ],
      "regra": "Nao confundir servidor Incus com cada membro de cluster."
    },
    {
      "entidade": "MembroCluster",
      "id_logico": "server_id + member_name",
      "campos": [
        "nome",
        "status",
        "arquitetura",
        "grupos"
      ],
      "regra": "So existe se Incus informa cluster configurado."
    },
    {
      "entidade": "Project",
      "id_logico": "server_id + nome",
      "campos": [
        "nome",
        "descricao",
        "limites",
        "permissoes"
      ],
      "regra": "Listagens e operacoes respeitam isolamento e autorizacao."
    },
    {
      "entidade": "Instance",
      "id_logico": "server_id + project + name",
      "campos": [
        "nome",
        "tipo",
        "status",
        "arquitetura",
        "location",
        "profiles",
        "devices",
        "created_at"
      ],
      "regra": "Nao usar apenas nome como ID global."
    },
    {
      "entidade": "Operacao",
      "id_logico": "server_id + operation_uuid",
      "campos": [
        "status_code",
        "status",
        "classe",
        "resources",
        "metadata_de_progresso",
        "error"
      ],
      "regra": "Nunca marcar concluida antes de status terminal confirmado."
    },
    {
      "entidade": "StoragePool",
      "id_logico": "server_id + nome",
      "campos": [
        "driver",
        "capacity",
        "used",
        "free",
        "fonte_medicao",
        "timestamp"
      ],
      "regra": "Metricas indisponiveis sao desconhecidas, nao zero; Btrfs requer cuidado."
    },
    {
      "entidade": "Imagem",
      "id_logico": "server_id + project + fingerprint",
      "campos": [
        "aliases",
        "architecture",
        "properties",
        "size",
        "created_at"
      ],
      "regra": "Arquitetura deve ser compativel com destino."
    },
    {
      "entidade": "Rede",
      "id_logico": "server_id + project + nome",
      "campos": [
        "type",
        "managed",
        "config",
        "state"
      ],
      "regra": "Exibir diferenca entre rede fisica, loopback e managed bridge."
    },
    {
      "entidade": "Profile",
      "id_logico": "server_id + project + nome",
      "campos": [
        "config",
        "devices",
        "used_by"
      ],
      "regra": "Distinguir config local e herdada."
    },
    {
      "entidade": "Snapshot",
      "id_logico": "server_id + project + instance + snapshot",
      "campos": [
        "created_at",
        "expires_at",
        "stateful"
      ],
      "regra": "Estimativa de tamanho nao corresponde necessariamente ao espaco fisico recuperavel."
    },
    {
      "entidade": "SessaoWeb",
      "id_logico": "session_id",
      "campos": [
        "identity",
        "role_visual",
        "issued_at",
        "expires_at",
        "authorized_scopes"
      ],
      "regra": "Nao armazenar segredo de Incus no frontend."
    },
    {
      "entidade": "Alerta",
      "id_logico": "server_id + target + tipo + instante",
      "campos": [
        "gravidade",
        "origem",
        "medicao",
        "mensagem",
        "estado"
      ],
      "regra": "Persistencia do historico so existe se houver armazenamento confiavel."
    }
  ],
